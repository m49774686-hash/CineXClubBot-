# ==================================================
# CineXClub Bot
# Environment Configuration
# ==================================================

# Telegram Bot Token
BOT_TOKEN=

# PostgreSQL Database URL
DATABASE_URL=

# Main Admin Telegram ID
ADMIN_ID=5279776003

# Admin Bot Link
ADMIN_BOT_LINK=https://t.me/CineXClubBot

# Force Join Channel ID
FORCE_JOIN_CHANNEL_ID=

# Force Join Channel Username
FORCE_JOIN_CHANNEL=@CineXClub

# Premium Channel ID
PREMIUM_CHANNEL_ID=

# Private Database Channel ID
DATABASE_CHANNEL_ID=

# Bot Username (Without @)
BOT_USERNAME=CineXClubBot

# Web Server Port (Render)
PORT=10000

# Environment
NODE_ENV=production

# Auto Delete Time (Minutes)
AUTO_DELETE_MINUTES=30

# Enable Force Join
FORCE_JOIN=true

# Enable Maintenance Mode
MAINTENANCE_MODE=false

# Default Welcome Image
WELCOME_IMAGE=

# Default Welcome Caption
WELCOME_CAPTION=Welcome, {name} 👋

# Search Cache TTL (Seconds)
CACHE_TTL=600

# Search Result Limit
SEARCH_LIMIT=20

# Rate Limit
RATE_LIMIT_SECONDS=3

# Enable Logs
ENABLE_LOGS=true

# Time Zone
TZ=Asia/Kolkata
